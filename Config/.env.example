DADATA_API=<токен-DaData>
DADATA_SECRET=<секрет-DaData>
TELEGRAM_BOT_TOKEN=<токен-бота-Telegram>

# Telegram Mini App
# Leave MINI_APP_URL empty to create a temporary HTTPS address automatically
# with Cloudflare Quick Tunnel whenever TRAVA starts.
# Set a permanent HTTPS address here only if you have your own tunnel/domain.
MINI_APP_URL=
MINI_APP_PORT=8765

# Telegram user IDs of florists, separated by commas
FLORIST_TELEGRAM_IDS=123456789
